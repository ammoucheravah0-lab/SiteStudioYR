{% comment %}
  sections/header.liquid
  Header sticky : logo | navigation | recherche + compte + panier
  Devient opaque au scroll grâce à la classe .is-scrolled (voir scrollytelling.js)
{% endcomment %}

<header class="site-header" data-header>
  <div class="container site-header__inner">

    <a href="{{ routes.root_url }}" class="site-header__logo">
      {{ section.settings.logo_text | default: "STUDIO" }}<span>{{ section.settings.logo_accent | default: "." }}</span>
    </a>

    <nav class="site-nav" aria-label="Navigation principale">
      <a href="{{ routes.root_url }}" {% if request.page_type == 'index' %}aria-current="page"{% endif %}>Accueil</a>
      <a href="{{ section.settings.tenues_url | default: '/collections/tenues' }}">Tenues</a>
      <a href="{{ section.settings.shorts_url | default: '/collections/shorts' }}">Shorts</a>
      <a href="{{ section.settings.tshirts_url | default: '/collections/t-shirts-polos' }}">T-shirts &amp; Polos</a>
      <a href="{{ section.settings.pantalons_url | default: '/collections/pantalons' }}">Pantalons</a>
      <a href="{{ section.settings.contact_url | default: '/pages/contact' }}">Contact</a>
    </nav>

    <div class="site-header__actions">

      <form action="{{ routes.search_url }}" method="get" role="search" class="header-search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="search" name="q" placeholder="Rechercher..." aria-label="Rechercher">
      </form>

      <a href="{{ routes.account_url }}" class="header-icon-btn" aria-label="Mon compte">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </a>

      <a href="{{ routes.cart_url }}" class="header-icon-btn" aria-label="Panier">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        {% if cart.item_count > 0 %}
          <span class="cart-count">{{ cart.item_count }}</span>
        {% endif %}
      </a>

      <button class="header-burger header-icon-btn" aria-label="Ouvrir le menu" data-menu-toggle>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>

    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Texte du logo", "default": "STUDIO" },
    { "type": "text", "id": "logo_accent", "label": "Point/accent du logo", "default": "." },
    { "type": "url", "id": "tenues_url", "label": "Lien Tenues" },
    { "type": "url", "id": "shorts_url", "label": "Lien Shorts" },
    { "type": "url", "id": "tshirts_url", "label": "Lien T-shirts & Polos" },
    { "type": "url", "id": "pantalons_url", "label": "Lien Pantalons" },
    { "type": "url", "id": "contact_url", "label": "Lien Contact" }
  ]
}
{% endschema %}
